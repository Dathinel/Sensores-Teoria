# Lo que NO se manda a Docker al construir la imagen (el "contexto"). Asi la construccion es
# rapida y la imagen no carga cosas que no usa ni que son de Windows.

# Entorno virtual de Windows (cientos de MB y binarios .exe/.pyd que en Linux no sirven)
entorno/
.venv/
venv/

# Firmware de los ESP32 (se flashea desde Arduino IDE, no corre en el contenedor)
firmware/

# Salidas del gemelo: se montan como volumen, no se copian
resultados/

# Imagenes, documentos y pruebas del tema
img/
pruebas/
*.pdf
*.png
*.jpg
*.mp4
*.docx
*.md

# Cache de Python y archivos de editores/sistema
__pycache__/
*.pyc
.pytest_cache/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Archivos de Docker y git (no hacen falta dentro de la imagen)
.git/
.gitignore
Dockerfile
docker-compose.yml
.dockerignore
