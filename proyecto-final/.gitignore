# El entorno virtual se autoexcluye con su propio .gitignore (entorno/.gitignore)
__pycache__/
*.pyc
.pytest_cache/

# bases de datos locales generadas por el supervisor / las pruebas
*.db
*.sqlite3

# pesos entrenados y datasets grandes: se documentan, no se versionan aqui
vision/modelos/*.h5
vision/modelos/*.tflite
vision/modelos/*.onnx

# claves y variables de entorno (seccion 14: la API key nunca va en el repo)
.env

# base de datos en modo WAL (archivos auxiliares)
*.db-shm
*.db-wal

# firmware armado para subir (firmware/preparar.py): se genera, no se versiona
firmware/salida/

# vision (fase 5): las fotos del dataset pesan y el entorno de TensorFlow (Python 3.12) es local;
# los resultados (matriz de confusion, curva, metricas) SI se versionan
vision/dataset/
vision/entorno/
vision/modelos/
