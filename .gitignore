# --- Entorno del sistema operativo ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Editores / IDEs ---
.vscode/
.idea/
*.swp

# --- PlatformIO ---
.pio/
.pioenvs/
.piolibdeps/

# --- Arduino IDE ---
build/
*.hex
*.bin
*.elf
*.map

# --- ESP-IDF ---
sdkconfig
sdkconfig.old
managed_components/

# Excepción a "*.bin": los pesos de la CNN del tema 8 que la app usa en el navegador (cnn.js).
# Los genera app/exportar_pesos_web.py, pero sin ellos la app descargada de GitHub no reconoce
# dígitos ("No se pudieron cargar los pesos de la red").
!8-digitos-brazo-y-vision/app/cnn-pesos.bin

# --- Python / MicroPython ---
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/
# Entornos virtuales de cada práctica (convención del repo: se llaman "entorno/" y los crea la
# app la primera vez). Cada uno ya trae su propio .gitignore con "*"; esta línea además hace que
# git ni entre a mirarlos (miles de archivos; con TensorFlow, rutas "Filename too long").
entorno/

# --- Node (herramientas de capturas o de Word, si se usan dentro del repo) ---
node_modules/

# --- Archivos temporales generales ---
*.log
*.tmp

# --- Secretos / variables de entorno ---
# .env lleva la API key de DeepSeek (temas 4 y proyecto final): nunca se sube. Las plantillas
# .env.example sí (dicen qué variables poner, sin valores reales).
.env
.env.*
!.env.example

# --- Bases de datos locales (las crean las simulaciones y las pruebas al correr) ---
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# --- Documentos de entrega para la uni (Word con el enlace al README): solo locales ---
Enlace README - *.docx
Enlace README - *.pdf

# Taller segundo corte: mallas de Baxter y Atlas (se bajan con descargar_modelos.py)
9-taller-segundo-corte/modelos/
# Recibo de entrega de Moodle (trae el ID de Turnitin)
9-taller-segundo-corte/*Taller Segundo Corte*UMNG.pdf
# Enjambre ACO: captura de la actividad en Moodle (trae nombre y foto del estudiante)
10-enjambre-algoritmo-hormigas/*Actividad 7*UMNG.pdf
# Enjambre ACO: salidas del gemelo (se regeneran); en pruebas/ quedan los resumenes json
10-enjambre-algoritmo-hormigas/resultados/*
!10-enjambre-algoritmo-hormigas/resultados/.gitkeep
10-enjambre-algoritmo-hormigas/pruebas/resultados/repeticiones/
10-enjambre-algoritmo-hormigas/pruebas/resultados/**/*.mp4
10-enjambre-algoritmo-hormigas/pruebas/resultados/**/*.png
10-enjambre-algoritmo-hormigas/pruebas/resultados/**/*.jsonl
# Zonas VLAN (tema 11): captura de Moodle (trae la tabla de notas de otros estudiantes) y salidas regenerables
11-zonas-virtualizadas-esp32-vlan/*Actividad 8*UMNG.pdf
11-zonas-virtualizadas-esp32-vlan/resultados/*
!11-zonas-virtualizadas-esp32-vlan/resultados/.gitkeep
11-zonas-virtualizadas-esp32-vlan/pruebas/resultados/**/*.mp4
11-zonas-virtualizadas-esp32-vlan/pruebas/resultados/**/*.jsonl
11-zonas-virtualizadas-esp32-vlan/borradores/
